{
  "description": "Repository lifecycle and validation hooks for Pokemon Solarus.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 session-start",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') session-start\"",
            "timeout": 10,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading Pokemon Solarus session state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 pre-tool",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') pre-tool\"",
            "timeout": 15,
            "statusMessage": "Checking repository command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 post-tool",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') post-tool\"",
            "timeout": 15,
            "statusMessage": "Validating edited project files"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 pre-compact",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') pre-compact\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 post-compact",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') post-compact\"",
            "timeout": 10,
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 subagent-start",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') subagent-start\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 subagent-stop",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') subagent-stop\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/project-hooks.ps1 session-end",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/project-hooks.ps1') session-end\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
